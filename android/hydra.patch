 import java.util.Date
 
 class ProfileImportHandler(private val context: Context) {
+    private fun isHydraLink(link: String) =
+        link.startsWith("hy2://") || link.startsWith("hysteria2://")
+
+    private fun hydraConfig(link: String): String {
+        require(link.toByteArray().size <= 65536) { "Profile link is too large" }
+        val parser = File(context.applicationInfo.nativeLibraryDir, "libhydra_import.so")
+        val process = ProcessBuilder(parser.absolutePath).redirectErrorStream(true).start()
+        try {
+            process.outputStream.bufferedWriter().use { it.write(link) }
+            val result = process.inputStream.bufferedReader().use { it.readText() }
+            check(process.waitFor() == 0) { result.trim() }
+            return result
+        } finally {
+            process.destroy()
+        }
+    }
